# Temporary debug: set 1 to enable, 0 to restore the login gate.
UNDERBOX_ICT_DEBUG_GUEST=0
UNDERBOX_ICT_DEBUG_QUOTA=5
# ICT-only unlimited usage; accounting and network safety remain enabled.
UNDERBOX_ICT_UNLIMITED=1
# Set to deepseek to use only the official DeepSeek Search API in ICT.
UNDERBOX_ICT_SEARCH_PROVIDER=
# Enable section-by-section splitting for complete verification of long resumes.
UNDERBOX_ICT_SPLIT_SECTIONS=0
