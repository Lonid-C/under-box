server {
    listen 18443 ssl;
    listen 443 ssl default_server;
    server_name 8.208.14.251;
    ssl_certificate /etc/nginx/ssl/underbox-ict-ip.pem;
    ssl_certificate_key /etc/nginx/ssl/underbox-ict-ip.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1k;
    access_log off;
    location = /health {
        proxy_pass http://127.0.0.1:18890;
    }
    location = /v1/fixture/verify {
        proxy_pass http://127.0.0.1:18890;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
    location ~ ^/v1/live/(submit|status|delete|action)$ {
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:18890;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }
    # Private ICT workbench; original domain and adapter routes are retained.
    location = /ict { return 302 /ict/; }
    location ^~ /ict/ {
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:18905/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /ict/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1800s;
    }
    location = /ict-next { return 302 /ict-next/; }
    location ^~ /ict-next/ {
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:18905/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /ict-next/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1800s;
    }
    location / { return 404; }
}
