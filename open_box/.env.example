# ── LLM：DeepSeek（默认供应商）────────────────────────────────────────
# 端点与模型名核对自 api-docs.deepseek.com（2026-09）
DEEPSEEK_API_KEY=sk-你的key

# 可选。默认 deepseek-flash（官方推荐），当前由 DeepSeek-V4.1-Flash 承接。
# 另一个可选值 deepseek-v4-pro。
#
# 填 deepseek-flash，不要填版本号：官方没有 deepseek-v4.1-flash 这个调用名，
# 而 deepseek-flash 会跟着官方升级自动指向最新的 Flash。
# deepseek-v4-flash 是已退役的旧名（仍被接受，按 Flash 价计费）；
# deepseek-chat / deepseek-reasoner 是更早的历史名称，已不在当前列表里。
# LLM_MODEL=deepseek-flash

# 可选。deepseek-flash 默认**开启思考**，reasoning_content 与正文共用 max_tokens。
# 实测 max_tokens=32 时 32 个 token 全花在 reasoning 上，content 返回空串、
# finish_reason=length——表现像"JSON 模式偶发空内容"，其实是预算被吃光。
# 核验是结构化抽取 + temperature=0，要的是确定性与可复现，所以默认关掉。
# 要开就设 enabled（成本与延迟都会上升）。
# LLM_THINKING=disabled

# 可选。自建网关或代理时覆盖；默认 https://api.deepseek.com/chat/completions
# LLM_ENDPOINT=

# 可选。默认 deepseek。换成 openai-compatible 时必须同时给 LLM_ENDPOINT 和 LLM_MODEL。
# LLM_PROVIDER=deepseek

# ── 搜索：尚未选定供应商 ──────────────────────────────────────────────
# 两个都给齐才会走真实检索，否则 search 返回空列表（查不到就是查不到，不编造）
# SEARCH_API_KEY=
# SEARCH_ENDPOINT=

# ── 搜索供应商（可选）────────────────────────────────────────────────
# SEARCH_ENGINE=search_pro        # search_std 更便宜；search_pro_sogou / search_pro_quark 换索引
# SEARCH_ENDPOINT=                # 端点有变时覆盖，用 make search-check 验
# SEARCH_PROVIDER=zhipu           # 或 generic（需同时给 SEARCH_ENDPOINT）

# ── 外部请求礼貌标识 ──────────────────────────────────────────────────
# 必须是纯 ASCII：HTTP 头是 latin-1 编码的，写中文会让每一个外部请求都失败。
# HTTP_USER_AGENT=ResumeVerifyDemo/0.1 (+resume verification; public pages only; contact: you@example.com)
