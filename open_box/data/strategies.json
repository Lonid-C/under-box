      "标题"
    ],
    "project": [
      "项目",
      "作品",
      "项目名称"
    ],
    "repo": [
      "仓库"
    ],
    "venue": [
      "刊物",
      "期刊",
      "会议"
    ],
    "major": [
      "专业",
      "方向"
