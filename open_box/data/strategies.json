  "profiles": [
    {
      "id": "cn-university-student",
      "name": "中国大陆在校生 / 应届生",
      "match": {
        "identity": [
          "student"
        ],
        "levels": [
          "intern",
          "entry",
          "unknown"
        ],
        "categories_any": [
          "校内荣誉",
          "奖学金",
          "学生工作",
          "竞赛",
          "项目",
          "学历"
        ]
      },
      "authority_map": [
        {
          "who": "学校学生工作部 / 研工部",
          "host": "school",
          "expect_tier": "A",
          "what": "评奖评优公示、名单、通知"
        },
        {
          "who": "学院官网",
          "host": "school",
          "expect_tier": "A",
          "what": "院级公示与任免"
        },
        {
          "who": "竞赛组委会",
          "host": "organizer",
          "expect_tier": "A",
          "what": "获奖名单、赛果公示"
        },
        {
          "who": "学校 / 学院公众号",
          "host": "wechat",
          "expect_tier": "B",
          "what": "换届公告、活动报道（仅已收录部分）"
        }
      ],
      "anchor_first": [
        "队伍名",
        "队友姓名组合",
        "仓库名",
        "导师姓名"
      ],
      "budget": {
        "searches": 8,
        "reads": 10,
        "seconds": 120
      },
      "extra_forms": [
        {
          "tpl": "\"{org}\" {year} 学年 评奖 公示",
          "site": "school",
          "round": 2,
          "weight": 70,
          "categories": [
            "校内荣誉",
            "奖学金"
          ],
          "purpose": "按学年找整批公示，再从名单里认人"
        },
        {
          "tpl": "\"{org}\" 优秀学生 名单 {year}",
          "site": "school",
          "round": 2,
          "weight": 65,
          "categories": [
            "校内荣誉",
            "奖学金"
          ],
          "purpose": "名单类页面"
        },
        {
          "tpl": "\"{org}\" {dept} 换届 公告",
          "site": "school",
          "round": 2,
          "weight": 72,
          "categories": [
            "学生工作"
          ],
          "purpose": "校内学生组织的任免公告"
        }
      ],
      "notes": [
        "校内任免与评奖多数**只在学校官网公示**，所以 site 限定是第一手段。",
        "公众号只能吃搜索引擎已收录的部分，收录率本就低——拿不到就标 none，这是产品上限，不硬突破。",
      "普通学历仅检索学校官网与已收录公众号的公开线索；学籍、学位及 GPA 仍需授权补证。"
      ]
    },
